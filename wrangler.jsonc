{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viahimalaya-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-04-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXTAUTH_URL": "https://viahimalaya.com",
    "NODE_ENV": "production",
    // Not a secret - it ships inside the APK in google-services.json. Used to
    // pin the issuer and audience when verifying Firebase ID tokens.
    "FIREBASE_PROJECT_ID": "viahimalaya-d673d"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "viahimalaya-web",
      "environment": "production"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Photos users submit from the app (custom_pois, migration 008). Private on
  // purpose: no public access and no custom domain, so a photo is reachable only
  // through this binding and nothing is visible until a route chooses to serve
  // it. Not the assets.viahimalaya.com bucket, which is public.
  // Create it once, before the first deploy that includes this:
  //   npx wrangler r2 bucket create viahimalaya-user-photos
  "r2_buckets": [
    {
      "binding": "USER_PHOTOS",
      "bucket_name": "viahimalaya-user-photos"
    }
  ],
  "routes": [
    {
      "pattern": "viahimalaya.com/api/*",
      "zone_name": "viahimalaya.com"
    }
  ],
  "observability": {
    "enabled": true
  }
}